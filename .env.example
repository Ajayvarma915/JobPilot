# JobPilot configuration. Copy to .env and edit. NEVER commit .env or put real secrets in this file.
# Every variable is optional; the defaults give a working local, single-user setup.

# --- Database -------------------------------------------------------------------------------
# SQLite file to use. Default: jobpilot.db in the project folder (the Docker image uses /app/storage/jobpilot.db).
# JOBPILOT_DATABASE_PATH=

# --- API protection (leave empty for local use) ----------------------------------------------
# When set, every /api request must send "Authorization: Bearer <this value>". Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JOBPILOT_API_TOKEN=
# Browser origins allowed to call the API (comma separated). Default: the local dev frontend.
# JOBPILOT_CORS_ORIGINS=https://jobs.example.com

# --- Local AI -------------------------------------------------------------------------------
# ollama (default) or none to switch AI off. No paid provider is ever used unless you add one yourself.
# JOBPILOT_AI_PROVIDER=ollama
# JOBPILOT_OLLAMA_BASE_URL=http://127.0.0.1:11434
# JOBPILOT_OLLAMA_MODEL=gemma3:4b
# Seconds before a model call is abandoned. A cold model on CPU can need more than the 180 default.
# JOBPILOT_OLLAMA_TIMEOUT=400

# --- Gmail (read-only) ----------------------------------------------------------------------
# Paths to your Google OAuth client file and where the access token is stored. Both stay out of git.
# JOBPILOT_GOOGLE_CLIENT_SECRETS=credentials/gmail_oauth_client.json
# JOBPILOT_GMAIL_TOKEN_PATH=tokens/gmail_token.json
# JOBPILOT_GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/email/oauth/callback

# --- Frontend build (compiled into public JavaScript: never put a shared secret here) ---------
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_API_TOKEN=
