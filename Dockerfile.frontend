# JobPilot frontend (React + Vite, served by nginx). Build from the project root:
#   docker build -f Dockerfile.frontend -t jobpilot-frontend --build-arg VITE_API_BASE_URL=http://127.0.0.1:8000 .
FROM node:22-alpine AS build
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# The API address and optional token are compiled into the public JavaScript.
ARG VITE_API_BASE_URL=http://127.0.0.1:8000
ARG VITE_API_TOKEN=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_API_TOKEN=$VITE_API_TOKEN
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /web/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
